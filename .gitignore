# ─────────────────────────────────────────────
# TraceForge — .gitignore (monorepo)
# ─────────────────────────────────────────────

# Entornos / secretos
.env
.env.*
!.env.example
*.local

# ── Python / backend (apps/api) ──
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
# uv mantiene uv.lock versionado (sí se commitea); se ignora la caché local
.uv/

# ── Node / frontend (apps/web, packages/shared) ──
node_modules/
dist/
dist-ssr/
build/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# ── Editores / SO ──
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
.DS_Store
Thumbs.db

# ── Herramientas ──
.task/

# OpenAPI volcado intermedio para generar tipos del frontend (task gen-types)
apps/api/openapi.json
