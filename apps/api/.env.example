# ── tf-api · variables de entorno (ejemplo) ──
# Copia este archivo a `.env` y ajústalo. Prefijo obligatorio: TF_
# En F0-T1 todas tienen valor por defecto; el archivo sirve de plantilla.

# Entorno lógico: development | staging | production
TF_ENVIRONMENT=development

# Versión reportada por GET /health (normalmente la deja el pyproject)
# TF_VERSION=0.1.0

# Orígenes permitidos para CORS (frontend de dev), separados por coma
TF_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL: llega en F0-T2 (aún no se usa)
# TF_DATABASE_URL=postgresql+psycopg://tf:tf@localhost:5432/traceforge
