# ── tf-api · variables de entorno (ejemplo) ──
# Copia este archivo a `.env` y ajústalo. Prefijo obligatorio: TF_
# El `.env` REAL no se commitea (.gitignore). Las passwords de ejemplo son solo
# para desarrollo local contra la infra de `task up`; nunca uses estos valores en
# staging/producción.
#
# DOS ARCHIVOS .env DISTINTOS (deben ser coherentes):
#   1) apps/api/.env   -> lo lee el BACKEND. Define TF_DATABASE_URL (usuario,
#      password y base embebidos en la URL).
#   2) .env en la RAÍZ -> lo lee COMPOSE para CREAR la base. Define TF_DB_USER /
#      TF_DB_PASSWORD / TF_DB_NAME (opcional; si no existe, compose usa los valores
#      por defecto tf / tf_dev_password / traceforge).
#   ⚠️ Las credenciales de la base DEBEN COINCIDIR entre ambos: el usuario/password/
#      base de TF_DATABASE_URL (aquí) tienen que ser los mismos que TF_DB_* de la raíz
#      (o los de por defecto de compose). Si no coinciden, el backend no conecta.

# Entorno lógico: development | staging | production
TF_ENVIRONMENT=development

# Versión reportada por GET /health (normalmente la deja el pyproject)
# TF_VERSION=0.1.0

# Orígenes permitidos para CORS (frontend de dev), separados por coma
TF_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── PostgreSQL (driver async asyncpg) — debe coincidir con compose.yaml ──
TF_DATABASE_URL=postgresql+asyncpg://tf:tf_dev_password@127.0.0.1:5432/traceforge

# ── Redis (configuración lista; sin uso en código todavía) ──
TF_REDIS_URL=redis://127.0.0.1:6379/0

# ── Almacenamiento S3 / MinIO — RESERVADO (DIFERIDO en F0-T2) ──
# MinIO no está levantado todavía (ver compose.yaml). Estas variables quedan como
# plantilla para cuando se implemente el almacenamiento; hoy no las usa el código.
TF_S3_ENDPOINT=http://127.0.0.1:9000
TF_S3_ACCESS_KEY=tf_minio
TF_S3_SECRET_KEY=tf_minio_dev_password
TF_S3_BUCKET=traceforge

# ── Variables que lee compose.yaml para crear la infra (opcionales) ──
# Si las defines en un `.env` en la RAÍZ del repo, compose las usa. Deben
# coincidir con TF_DATABASE_URL de arriba.
# TF_DB_NAME=traceforge
# TF_DB_USER=tf
# TF_DB_PASSWORD=tf_dev_password
